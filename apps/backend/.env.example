# CartCart backend local configuration.
# Copy to apps/backend/.env only when you need local overrides.
# Do not put real secrets in this example file.

# Runtime mode: local, test, fixture, live, or production.
CARTCART_ENVIRONMENT=local

# Local backend server settings.
CARTCART_BACKEND_HOST=127.0.0.1
CARTCART_BACKEND_PORT=8000
CARTCART_BACKEND_RELOAD=true
CARTCART_LOG_LEVEL=INFO
CARTCART_FRONTEND_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# OpenTelemetry is disabled by default.
# Use console for local JSON-ish span output, or otlp for a local collector.
CARTCART_TELEMETRY_ENABLED=false
CARTCART_TELEMETRY_EXPORTER=console
CARTCART_TELEMETRY_SERVICE_NAME=cartcart-backend
CARTCART_TELEMETRY_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Local persistence paths. Defaults point at the repository-level data/ directory.
# Use absolute paths when overriding to avoid command working-directory ambiguity.
# CARTCART_DATA_DIR=/absolute/path/to/CartCart/data
# CARTCART_DATABASE_PATH=/absolute/path/to/CartCart/data/cartcart.sqlite3
# CARTCART_ARTIFACT_DIR=/absolute/path/to/CartCart/data/artifacts
