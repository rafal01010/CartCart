# CartCart backend local configuration.
# Copy to apps/backend/.env only when you need local overrides.
# Do not put real secrets in this example file.

# Runtime mode: local, test, fixture, live, or production.
CARTCART_ENVIRONMENT=local

# Local backend server settings.
CARTCART_BACKEND_HOST=127.0.0.1
CARTCART_BACKEND_PORT=8000
CARTCART_BACKEND_RELOAD=true
CARTCART_LOG_LEVEL=INFO
CARTCART_FRONTEND_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Provider defaults. Fixture/stub mode works without any provider keys.
CARTCART_DEFAULT_REGION_CODE=US
CARTCART_PROVIDER_TIMEOUT_SECONDS=10
CARTCART_PROVIDER_RATE_LIMIT_PER_MINUTE=60
CARTCART_SOURCE_FETCH_MAX_CONTENT_BYTES=2097152
CARTCART_SOURCE_FETCH_USER_AGENT="CartCart/0.1 source-fetcher"

# General web search provider. Tavily is implemented; live use remains opt-in.
# Supported values: fixture, tavily, brave.
CARTCART_SEARCH_PROVIDER=fixture
CARTCART_SEARCH_PROVIDER_ENABLED=false
# CARTCART_TAVILY_API_KEY=replace-with-local-secret
# CARTCART_BRAVE_SEARCH_API_KEY=replace-with-local-secret

# Source extraction provider. http_static uses the local HTTP fetcher and
# Trafilatura extractor; no provider credential is required.
# Supported values: disabled, fixture, http_static.
CARTCART_EXTRACTION_PROVIDER=fixture
CARTCART_EXTRACTION_PROVIDER_ENABLED=false

# SerpApi is used only by the optional Amazon intelligence adapter.
# CARTCART_SERPAPI_API_KEY=replace-with-local-secret

# YouTube video metadata search. Official API metadata only; transcripts are
# not checked by this adapter.
# Supported values: disabled, fixture, youtube.
CARTCART_VIDEO_SEARCH_PROVIDER=fixture
CARTCART_VIDEO_SEARCH_PROVIDER_ENABLED=false
# CARTCART_YOUTUBE_DATA_API_KEY=replace-with-local-secret

# YouTube public-caption retrieval. Live yt_dlp mode uses the backend-pinned
# yt-dlp/yt-dlp-ejs packages and Deno runtime; it never uses cookies or media.
# Supported values: disabled, fixture, yt_dlp.
CARTCART_TRANSCRIPT_PROVIDER=fixture
CARTCART_TRANSCRIPT_PROVIDER_ENABLED=false
CARTCART_YOUTUBE_TRANSCRIPT_LANGUAGES='["en"]'
CARTCART_YOUTUBE_TRANSCRIPT_DENO_EXECUTABLE=deno
CARTCART_YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=30
CARTCART_YOUTUBE_TRANSCRIPT_OUTPUT_LIMIT_BYTES=65536
CARTCART_YOUTUBE_TRANSCRIPT_TEMP_STORAGE_LIMIT_BYTES=5242880
CARTCART_YOUTUBE_TRANSCRIPT_MAX_SEGMENTS=5000

# Amazon product/listing/review intelligence. SerpApi live use is optional and
# reuses CARTCART_SERPAPI_API_KEY.
# Supported values: disabled, fixture, serpapi.
CARTCART_AMAZON_PRODUCT_INTELLIGENCE_PROVIDER=fixture
CARTCART_AMAZON_PRODUCT_INTELLIGENCE_PROVIDER_ENABLED=false

# IKEA regional official-store intelligence. Search mode reuses the configured
# general search provider and its credentials.
# Supported values: disabled, fixture, search.
CARTCART_IKEA_STORE_INTELLIGENCE_PROVIDER=fixture
CARTCART_IKEA_STORE_INTELLIGENCE_PROVIDER_ENABLED=false

# Local frontend server settings used by scripts/local/start-frontend.sh.
CARTCART_FRONTEND_HOST=127.0.0.1
CARTCART_FRONTEND_PORT=5173
# PUBLIC_CARTCART_API_BASE_URL=http://127.0.0.1:8000

# OpenTelemetry is disabled by default.
# Use console for local JSON-ish span output, or otlp for a local collector.
CARTCART_TELEMETRY_ENABLED=false
CARTCART_TELEMETRY_EXPORTER=console
CARTCART_TELEMETRY_SERVICE_NAME=cartcart-backend
CARTCART_TELEMETRY_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Local persistence paths. Defaults point at the repository-level data/ directory.
# Use absolute paths when overriding to avoid command working-directory ambiguity.
# CARTCART_DATA_DIR=/absolute/path/to/CartCart/data
# CARTCART_DATABASE_PATH=/absolute/path/to/CartCart/data/cartcart.sqlite3
# CARTCART_ARTIFACT_DIR=/absolute/path/to/CartCart/data/artifacts
# CARTCART_RUN_DIR=/absolute/path/to/CartCart/data/run
# CARTCART_LOG_DIR=/absolute/path/to/CartCart/data/logs

# Local artifact retention policy. Set a retention value to 0 only for
# "delete on next cleanup" behavior; it does not disable structured SQLite records.
CARTCART_RAW_SOURCE_SNAPSHOT_RETENTION_DAYS=30
CARTCART_EXTRACTED_CONTENT_RETENTION_DAYS=30
CARTCART_SCREENSHOT_RETENTION_DAYS=7
CARTCART_AGENT_OUTPUT_RETENTION_DAYS=30
CARTCART_TRACE_RETENTION_DAYS=14
CARTCART_EVAL_ARTIFACT_RETENTION_DAYS=30
CARTCART_SCREENSHOTS_ENABLED=false

# MVP privacy control. This is intentionally false-only.
CARTCART_CROSS_SESSION_PREFERENCE_PROFILING_ENABLED=false
